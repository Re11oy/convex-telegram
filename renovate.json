{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "Europe/Helsinki",
  "schedule": ["* 6-9 * * 0,6"],
  "automergeSchedule": ["at any time"],
  "minimumReleaseAge": "14 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "labels": ["security"],
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* 6-9 * * 6"],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "config:best-practices sets 3 days for npm; keep 14",
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": "14 days"
    },
    {
      "groupName": "Routine updates",
      "matchPackageNames": ["!@gramio/types", "!convex"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "convex updates change committed _generated code; run pnpm codegen by hand",
      "matchPackageNames": ["convex"],
      "automerge": false,
      "prBodyNotes": [
        "⚠️ Before merging, run `pnpm codegen`, commit any `_generated` changes, and check the Vercel preview."
      ]
    },
    {
      "description": "Release every @gramio/types version: own fix(deps) PR, 3-day wait, any time",
      "matchPackageNames": ["@gramio/types"],
      "minimumReleaseAge": "3 days",
      "schedule": ["at any time"],
      "rangeStrategy": "bump",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "matchPackageNames": ["@gramio/types"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "New Bot API major: feat(deps) PR for review",
      "matchPackageNames": ["@gramio/types"],
      "matchUpdateTypes": ["major"],
      "semanticCommitType": "feat",
      "dependencyDashboardApproval": false
    }
  ]
}
